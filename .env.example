# Required for live multi-agent analysis (mock fallback works without this)
OPENAI_API_KEY=

# Model used for both structured LangGraph calls
OPENAI_MODEL=gpt-4o

# Abort analyze pipeline after this many ms
ANALYZE_TIMEOUT_MS=45000

# Force mock/demo mode even if OPENAI_API_KEY is set
FORCE_MOCK=false

# Optional: fal.ai carousel cover generation
FAL_KEY=

# Optional stretch: n8n webhook export (not used by core flow)
N8N_WEBHOOK_URL=
