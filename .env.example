# ── OpenAI (preferred live language path) ───────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_AUDIENCE_MODEL=gpt-4o-mini
OPENAI_JUROR_MODEL=gpt-4o-mini
OPENAI_CRITIC_MODEL=gpt-4o-mini
OPENAI_STRATEGY_MODEL=gpt-4o-mini

# ── fal.ai (fallback LM if OpenAI unset; primary for cover images) ───────────
# https://fal.ai/dashboard/keys
FAL_KEY=

# Unified language model endpoint (used only when OPENAI_API_KEY is empty)
FAL_TEXT_ENDPOINT=fal-ai/any-llm

# Model IDs for fal-ai/any-llm (verified against fal catalog)
FAL_AUDIENCE_MODEL=google/gemini-2.5-flash-lite
FAL_JUROR_MODEL=google/gemini-2.5-flash
FAL_CRITIC_MODEL=anthropic/claude-3-5-haiku
FAL_STRATEGY_MODEL=google/gemini-2.5-flash
# Image generation endpoint (not any-llm)
FAL_IMAGE_MODEL=fal-ai/flux/dev

# ── Optional Firecrawl (source URL → comments / page text) ───────────────────
# https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# ── Optional ElevenLabs voiceover ────────────────────────────────────────────
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Optional n8n export ──────────────────────────────────────────────────────
# Paste Production webhook URL after importing n8n/thunder-approved-content.workflow.json
N8N_WEBHOOK_URL=
N8N_API_URL=
N8N_API_KEY=

# ── Auth foundation (optional — public demo works without these) ─────────────
# When either is set, costly routes require auth (except seeded / no-LM analyze).
# https://dashboard.clerk.com/
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Simple Bearer token for scripts / CI (Authorization: Bearer …)
THUNDER_API_TOKEN=

# ── Redis rate limits (Upstash REST — preferred for multi-instance) ──────────
# https://console.upstash.com/
# If unset: in-memory limits + console warning (single instance only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional Sentry (error monitoring stub until @sentry/nextjs is wired) ───
# https://sentry.io/
SENTRY_DSN=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Thunder
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Allow recovery fallback when live LM is missing or fails (never silent fake-live)
THUNDER_ENABLE_FALLBACK=true

# Public demo spend guard (per IP; Redis when Upstash env set, else in-memory)
# Analyze defaults to 6/hour in code; override window/limit here if needed
THUNDER_RATE_LIMIT=8
THUNDER_RATE_WINDOW_MS=3600000

# Abort analyze pipeline after this many ms
ANALYZE_TIMEOUT_MS=90000

# Force seeded demo path even if OPENAI_API_KEY / FAL_KEY is set
FORCE_SEEDED_DEMO=false
